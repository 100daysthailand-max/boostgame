{
  "name": "@gametwo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:local": "tsx dev/dev-server.ts",
    "smoke": "tsx dev/smoke.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
"dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1",
    "@types/node": "^22.10.2",
    "@types/express": "^4.17.21"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
